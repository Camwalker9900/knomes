# Knomes — environment configuration (spec §54).
# Copy to `.env` and adjust as needed:  cp .env.example .env
# Every value shown below is the development default already baked into
# apps/api/app/core/config.py — uncomment a line only to override it.
# Never commit a real `.env` or any real secret.

# --- Database (PostgreSQL 16 + PostGIS; sync SQLAlchemy, psycopg driver) ---
# Host port 5433 (compose maps 5433->5432 to avoid clashing with local Postgres/proxies)
# DATABASE_URL=postgresql+psycopg://knomes:knomes@localhost:5433/knomes

# --- Redis (RQ job queue) ---
# REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO in dev; any S3-compatible store in prod) ---
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=knomes-dev
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# --- MLS provider (Repliers — deferred; unused in Phases 0-3, leave empty) ---
# REPLIERS_API_KEY=

# --- Application ---
# ADMIN_EMAIL=admin@example.com
# APP_ENV=development
# APP_SECRET=dev-secret-change-me

# --- Ingestion sources (optional) ---
# Real_acct_owner.zip URL for scripts/fetch_hcad_sample.py / live HCAD sync
# HCAD_DOWNLOAD_URL=https://download.hcad.org/data/CAMA/2026/Real_acct_owner.zip
# Houston open-data CKAN portal + Building Code Enforcement resource id
# HOUSTON_CKAN_BASE_URL=https://data.houstontx.gov
# "All Code Enforcement Violations in FORMS Since 2014" (public, no key needed):
# HOUSTON_CODE_RESOURCE_ID=1446a3ec-2633-4cf1-b15d-6dae9a07c4ed
# Houston code-enforcement project actions (public, no key)
# HOUSTON_ACTIONS_RESOURCE_ID=84a171f2-d601-4c79-bc4d-9733b378c663
# HOUSTON_ACTIONS_PRE2014_RESOURCE_ID=58d4a211-6abe-4fa9-b12e-c065b81e2bbb
# HCAD building/land details + GIS parcels (public downloads)
# HCAD_BUILDING_ZIP_URL=https://download.hcad.org/data/CAMA/2026/Real_building_land.zip
# HCAD_GIS_PARCELS_URL=
# Houston permits source (under investigation — see docs/data-sources.md)
# HOUSTON_PERMITS_SOURCE_URL=
